{
  "name": "careflow-pilot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -s first npm:dev:server npm:dev:client",
    "dev:server": "node --env-file-if-exists=.env --watch --import tsx src/server/server.ts",
    "dev:client": "vite --host 127.0.0.1 --port 5173",
    "clean": "rimraf dist",
    "build": "npm run clean && npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsup",
    "start": "node --env-file-if-exists=.env dist/server/server.js",
    "test": "npm run test:client && npm run test:server",
    "test:client": "vitest run --config vitest.client.config.ts",
    "test:server": "vitest run --config vitest.server.config.ts",
    "test:e2e": "npm run build && playwright test",
    "typecheck": "npm run typecheck:client && npm run typecheck:server",
    "typecheck:client": "tsc -p tsconfig.client.json --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "reset:synthetic": "node --env-file-if-exists=.env --import tsx scripts/reset-synthetic-data.ts",
    "users": "node --env-file-if-exists=.env --import tsx scripts/users.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.0",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.2",
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@fontsource/noto-sans-thai": "5.3.0",
    "@tanstack/react-query": "5.101.4",
    "argon2": "0.45.1",
    "better-sqlite3": "13.0.2",
    "drizzle-orm": "0.45.2",
    "fast-json-stable-stringify": "2.1.0",
    "fastify": "5.11.0",
    "lucide-react": "1.28.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "7.18.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "10.0.4",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.9.0",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "postcss": "8.5.25",
    "rimraf": "6.1.3",
    "tailwindcss": "4.2.1",
    "tsup": "8.5.1",
    "tsx": "4.23.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.0.13",
    "vitest": "4.1.10"
  }
}
