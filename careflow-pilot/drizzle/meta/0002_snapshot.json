          "name": "intake_heart_rate_check",
          "value": "\"intake_observations\".\"heart_rate_bpm\" IS NULL OR \"intake_observations\".\"heart_rate_bpm\" BETWEEN 20 AND 250"
        },
        "intake_spo2_check": {
          "name": "intake_spo2_check",
          "value": "\"intake_observations\".\"spo2_percent\" IS NULL OR \"intake_observations\".\"spo2_percent\" BETWEEN 50 AND 100"
        },
        "intake_blood_pressure_relationship_check": {
          "name": "intake_blood_pressure_relationship_check",
          "value": "\"intake_observations\".\"systolic_mmhg\" IS NULL OR \"intake_observations\".\"diastolic_mmhg\" IS NULL OR \"intake_observations\".\"systolic_mmhg\" >= \"intake_observations\".\"diastolic_mmhg\""
        }
      }
