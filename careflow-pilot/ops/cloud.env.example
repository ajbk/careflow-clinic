# Review-only example. No provider, disk, DNS, certificate or credentials are provisioned.
NODE_ENV=production
CAREFLOW_PROFILE=cloud
CAREFLOW_HOST=127.0.0.1
CAREFLOW_PORT=3001
CAREFLOW_PUBLIC_ORIGIN=https://clinic.example.invalid
CAREFLOW_TRUSTED_PROXIES=127.0.0.1
CAREFLOW_ENVIRONMENT_ID=synthetic-clinic
CAREFLOW_DB_PATH=/var/lib/careflow/clinic.sqlite
CAREFLOW_CLIENT_DIST=/opt/careflow/current/dist/client
CAREFLOW_COOKIE_SECURE=true
# Set only after an agreed backup-age policy and verified external backup/restore adapter.
# CAREFLOW_BACKUP_MAX_AGE_SECONDS=<approved_seconds_60_to_604800>
# No private recovery key belongs in the app environment or on the app host.
