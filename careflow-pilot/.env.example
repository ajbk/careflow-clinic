# Synthetic-only Local Pilot. Never point this file at real patient data.
CAREFLOW_HOST=127.0.0.1
CAREFLOW_PORT=3001
# Replace with an absolute path, for example:
# CAREFLOW_DB_PATH=/Users/you/careflow-pilot/data/careflow.sqlite
CAREFLOW_DB_PATH=/absolute/path/to/careflow.sqlite
CAREFLOW_COOKIE_SECURE=false
CAREFLOW_CLIENT_DIST=./dist/client
